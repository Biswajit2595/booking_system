generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZER
  CUSTOMER
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role

  events    Event[]
  bookings  Booking[]

  createdAt DateTime @default(now())
}

model Event {
  id                 String    @id @default(cuid())
  title              String
  description        String
  totalTickets       Int
  availableTickets   Int
  price              Float

  organizerId        String
  organizer          User @relation(fields: [organizerId], references: [id])

  bookings           Booking[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Booking {
  id          String   @id @default(cuid())

  quantity    Int

  eventId     String
  customerId  String

  event        Event @relation(fields: [eventId], references: [id])
  customer     User  @relation(fields: [customerId], references: [id])

  createdAt    DateTime @default(now())
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String   @unique
  response    Json
  createdAt   DateTime @default(now())
}